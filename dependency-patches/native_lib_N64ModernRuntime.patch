diff --git a/ultramodern/include/ultramodern/ultramodern.hpp b/ultramodern/include/ultramodern/ultramodern.hpp
index 3b28af3..9caca4d 100644
--- a/ultramodern/include/ultramodern/ultramodern.hpp
+++ b/ultramodern/include/ultramodern/ultramodern.hpp
@@ -21,8 +21,97 @@
 #include "ultramodern/rsp.hpp"
 #include "ultramodern/threads.hpp"
 
+#if defined(__APPLE__)
+#include <exception>
+#include <functional>
+#include <memory>
+#include <pthread.h>
+#include <system_error>
+#include <utility>
+#endif
+
+namespace ultramodern {
+#if defined(__APPLE__)
+    // RR64-MAC: macOS gives every thread but the main one a 512 KB stack, and
+    // std::thread cannot ask for more. Game threads run recompiled N64 code and
+    // the port's own systems, which are sized for Linux's 8 MB default (one
+    // clears a 722 KB array at race start), so they overflow on macOS. Start
+    // them through pthreads with 8 MB instead. Same interface as the parts of
+    // std::thread the runtime uses.
+    class HostThread {
+    public:
+        static constexpr size_t stack_size = 8 * 1024 * 1024;
+
+        HostThread() noexcept = default;
+
+        template <typename F, typename... Args>
+        explicit HostThread(F&& f, Args&&... args) {
+            auto body = std::make_unique<std::function<void()>>(
+                [f = std::forward<F>(f), ... args = std::forward<Args>(args)]() mutable {
+                    std::invoke(std::move(f), std::move(args)...);
+                });
+            pthread_attr_t attr;
+            pthread_attr_init(&attr);
+            pthread_attr_setstacksize(&attr, stack_size);
+            const int error = pthread_create(&handle_, &attr, &HostThread::entry, body.get());
+            pthread_attr_destroy(&attr);
+            if (error != 0) {
+                throw std::system_error(error, std::generic_category(), "pthread_create");
+            }
+            body.release(); // owned by the new thread now
+            joinable_ = true;
+        }
+
+        HostThread(HostThread&& other) noexcept
+            : handle_(other.handle_), joinable_(std::exchange(other.joinable_, false)) {}
+
+        HostThread& operator=(HostThread&& other) noexcept {
+            if (joinable_) {
+                std::terminate(); // as std::thread
+            }
+            handle_ = other.handle_;
+            joinable_ = std::exchange(other.joinable_, false);
+            return *this;
+        }
+
+        HostThread(const HostThread&) = delete;
+        HostThread& operator=(const HostThread&) = delete;
+
+        ~HostThread() {
+            if (joinable_) {
+                std::terminate(); // as std::thread
+            }
+        }
+
+        bool joinable() const noexcept { return joinable_; }
+
+        void join() {
+            pthread_join(handle_, nullptr);
+            joinable_ = false;
+        }
+
+        void detach() {
+            pthread_detach(handle_);
+            joinable_ = false;
+        }
+
+    private:
+        static void* entry(void* arg) noexcept {
+            std::unique_ptr<std::function<void()>> body(static_cast<std::function<void()>*>(arg));
+            (*body)();
+            return nullptr;
+        }
+
+        pthread_t handle_{};
+        bool joinable_ = false;
+    };
+#else
+    using HostThread = std::thread;
+#endif
+}
