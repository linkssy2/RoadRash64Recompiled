+    static void rr64ObserveMatch(unsigned category, const GameFrame &frame, const WorkloadQueue &queue,
+        const RR64GeometryMatchContext &context, const GameIndices::Projection &indices, uint32_t worldIndex) {
+        using namespace RR64MatchingEvidence;
+        if (!enabled()) { return; }
+        const int slot = buffer.claim(category);
+        if (slot < 0) { return; }
+        Record r; r.category=category; r.world=worldIndex;
+        r.framebuffer=indices.fbPairIndex; r.projection=indices.projectionIndex;
+        const auto &load=queue.workloads[indices.workloadIndex];
+        r.submission=load.submissionFrame; r.workload=load.workloadId;
+        const auto &data=load.drawData;
+        const auto &projection=load.fbPairs[indices.fbPairIndex].projections[indices.projectionIndex];
+        r.view=projection.transformsIndex;
+        if(r.view<data.viewProjTransformGroups.size() && data.viewProjTransformGroups[r.view]<data.transformGroups.size()) {
+            r.viewId=data.transformGroups[data.viewProjTransformGroups[r.view]].matrixId;
+        }
+        auto position=[](const hlslpp::float4x4 &m) { return std::array<float,3>{m[3][0],m[3][1],m[3][2]}; };
+        auto id=[](const DrawData &d,uint32_t t) {
+            return t<d.worldTransformGroups.size() && d.worldTransformGroups[t]<d.transformGroups.size() ?
+                d.transformGroups[d.worldTransformGroups[t]].matrixId : UINT32_MAX;
+        };
+        if(worldIndex<data.worldTransforms.size()) {
+            r.worldAfter=position(data.worldTransforms[worldIndex]); r.id=id(data,worldIndex);
+            captureSource(r,data,worldIndex,false);
+            for(uint32_t t=0;t<data.worldTransforms.size();t++) { r.idOccurrences+=id(data,t)==r.id; }
+            if(worldIndex<data.worldTransformGroups.size() && data.worldTransformGroups[worldIndex]<data.transformGroups.size()) {
+                const auto &group=data.transformGroups[data.worldTransformGroups[worldIndex]];
+                r.positionPolicy=group.positionInterpolation; r.ordering=group.ordering;
+            }
+            if(const auto *match=context.get(indices.workloadIndex,worldIndex)) {
+                r.vertices=uint32_t(match->evidence->positionCount/3);
+                r.indices=uint32_t(match->evidence->topology.size()); r.topologyHash=match->evidence->topologyHash;
+            }
+        }
+        if(r.view<data.viewTransforms.size()) { r.viewAfter=position(data.viewTransforms[r.view]); }
+        if(indices.workloadIndex<frame.frameMap.workloads.size()) {
+            const auto &mapping=frame.frameMap.workloads[indices.workloadIndex];
+            if(mapping.mapped && mapping.prevWorkloadIndex<queue.workloads.size()) {
+                const auto &previous=queue.workloads[mapping.prevWorkloadIndex].drawData;
+                for(uint32_t t=0;t<previous.worldTransforms.size();t++) { r.previousIdOccurrences+=id(previous,t)==r.id; }
+                if(worldIndex<mapping.transforms.size()) {
+                    const auto &world=mapping.transforms[worldIndex]; r.mapped=world.mapped; r.worldLerp=world.rigidBody.lerpTranslation;
+                    if(world.mapped && world.prevTransformIndex<previous.worldTransforms.size()) {
+                        r.previousWorld=world.prevTransformIndex; r.previousId=id(previous,r.previousWorld);
+                        r.worldBefore=position(previous.worldTransforms[r.previousWorld]);
+                        captureSource(r,previous,r.previousWorld,true);
+                    }
+                }
+                if(r.view<mapping.viewProjections.size()) {
+                    const auto &view=mapping.viewProjections[r.view]; r.viewLerp=view.rigidBody.lerpTranslation;
+                    if(view.mapped && view.prevTransformIndex<previous.viewTransforms.size()) {
+                        r.viewBefore=position(previous.viewTransforms[view.prevTransformIndex]);
+                        const auto t=view.prevTransformIndex;
+                        if(t<previous.viewProjTransformGroups.size() && previous.viewProjTransformGroups[t]<previous.transformGroups.size()) {
+                            r.previousViewId=previous.transformGroups[previous.viewProjTransformGroups[t]].matrixId;
+                        }
+                    }
+                }
+            }
+        }
+        buffer.publish(category,unsigned(slot),r);
+    }
