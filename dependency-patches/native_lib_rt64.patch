+    using RR64ProjectionRole = std::array<int64_t, 16>;
+    static std::set<RR64ProjectionRole> rr64SceneRoles(const WorkloadQueue &queue, const GameScene &scene) {
+        std::set<RR64ProjectionRole> roles;
+        for (const auto &indices : scene.projections) {
+            const auto &workload = queue.workloads[indices.workloadIndex];
+            const auto &pair = workload.fbPairs[indices.fbPairIndex];
+            const auto &projection = pair.projections[indices.projectionIndex];
+            if (projection.gameCallCount == 0) { continue; }
+            const auto &rect = projection.scissorRect;
+            RR64ProjectionRole role = { int64_t(projection.type), pair.colorImage.width,
+                pair.colorImage.fmt, pair.colorImage.siz, pair.depthRead, pair.depthWrite,
+                rect.ulx, rect.uly, rect.lrx, rect.lry };
+            const auto &data = workload.drawData;
+            const uint32_t t = projection.transformsIndex;
+            if ((t < data.rspViewports.size()) && (uint64_t(t) * 4 + 4 <= data.viewportClipRatios.size()) &&
+                (t < data.viewportOrigins.size())) {
+                const auto viewport = data.rspViewports[t].rect(&data.viewportClipRatios[t * 4]);
+                role[10] = viewport.ulx; role[11] = viewport.uly;
+                role[12] = viewport.lrx; role[13] = viewport.lry;
+                role[14] = data.viewportOrigins[t]; role[15] = 1;
+            }
+            roles.insert(role);
+        }
+        return roles;
+    }
