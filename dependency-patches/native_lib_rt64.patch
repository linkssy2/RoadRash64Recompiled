+    // Finish immutable evidence before assigning pair-local token IDs. The
+    // submitted position stream is read-only until Workload::resetDrawData.
+    static void rr64HashGeometry(RR64WorkloadGeometry &geometry) {
+        RR64PipelineDiagnostics::Scope scope(RR64PipelineDiagnostics::Stage::GeometryHash);
+        std::vector<uint32_t> positionBits;
+        for (auto &mesh : geometry.transforms) {
+            if (!mesh.used || mesh.skipCertification) { continue; }
+            mesh.valid = mesh.valid && mesh.positions && mesh.positionCount &&
+                mesh.positionCount % 3 == 0 && !mesh.topology.empty() &&
+                mesh.topology.size() % 3 == 0 &&
+                uint64_t(mesh.positionCount / 3) <= uint64_t(UINT32_MAX) + 1;
+            if (!mesh.valid) { continue; }
+            mesh.topologyHash = XXH3_64bits(mesh.topology.data(), mesh.topology.size() * sizeof(uint32_t));
+            positionBits.resize(mesh.positionCount);
+            for (size_t i = 0; i < mesh.positionCount; i++) {
+                if (!std::isfinite(mesh.positions[i])) { mesh.valid = false; break; }
+                uint32_t bits = 0;
+                if (mesh.positions[i] != 0.0f) { std::memcpy(&bits, &mesh.positions[i], sizeof(bits)); }
+                positionBits[i] = bits;
+            }
+            if (mesh.valid) {
+                mesh.geometryHash = XXH3_64bits_withSeed(positionBits.data(), positionBits.size() * sizeof(uint32_t), mesh.topologyHash);
+            }
+        }
+    }
