+    static void rr64InternGeometry(RR64GeometryMatchContext &context) {
+        RR64PipelineDiagnostics::Scope diagnosticScope(RR64PipelineDiagnostics::Stage::GeometryIntern);
+        std::unordered_map<uint64_t, std::vector<RR64TransformMatch *>> geometryBuckets, topologyBuckets;
+        uint32_t nextGeometry = 1, nextTopology = 1;
+        for (auto &entry : context.workloads) {
+            for (auto &match : entry.second.transforms) {
+                const auto &mesh = *match.evidence;
+                if (!mesh.used || mesh.skipCertification || !mesh.valid) { continue; }
+                const uint64_t topologyHash = mesh.topologyHash;
+                const uint64_t geometryHash = mesh.geometryHash;
+                // Cached hashes only select buckets; exact equality remains
+                // mandatory, including signed-zero numeric equality.
+                for (const auto *other : topologyBuckets[topologyHash]) {
+                    if ((mesh.positionCount == other->evidence->positionCount) && (mesh.topology == other->evidence->topology)) {
+                        match.topologyToken = other->topologyToken;
+                        break;
+                    }
+                }
+                if (match.topologyToken == 0) {
+                    match.topologyToken = nextTopology++;
+                    topologyBuckets[topologyHash].push_back(&match);
+                }
+                for (const auto *other : geometryBuckets[geometryHash]) {
+                    if ((match.topologyToken == other->topologyToken) &&
+                        (std::memcmp(mesh.positions, other->evidence->positions, mesh.positionCount * sizeof(float)) == 0 ||
+                         std::equal(mesh.positions, mesh.positions + mesh.positionCount, other->evidence->positions))) {
+                        match.geometryToken = other->geometryToken;
+                        break;
+                    }
+                }
+                if (match.geometryToken == 0) {
+                    match.geometryToken = nextGeometry++;
+                    geometryBuckets[geometryHash].push_back(&match);
+                }
+            }
+        }
+    }
