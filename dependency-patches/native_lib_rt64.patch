+    static RR64WorkloadGeometry rr64CollectGeometry(const Workload &workload, bool skipExplicitCertification) {
+        RR64PipelineDiagnostics::Scope diagnosticScope(RR64PipelineDiagnostics::Stage::GeometryCollect);
+        RR64WorkloadGeometry result;
+        const auto &data = workload.drawData;
+        result.transforms.resize(data.worldTransforms.size());
+        for (size_t t = 0; t < result.transforms.size(); t++) {
+            auto &mesh = result.transforms[t];
+            if (skipExplicitCertification && t < data.worldTransformGroups.size() &&
+                data.worldTransformGroups[t] < data.transformGroups.size()) {
+                const auto &group = data.transformGroups[data.worldTransformGroups[t]];
+                mesh.skipCertification = group.matrixId != G_EX_ID_AUTO && group.matrixId != G_EX_ID_IGNORE && group.ordering == G_EX_ORDER_LINEAR;
+            }
