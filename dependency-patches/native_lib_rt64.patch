+    static bool rr64SceneTranslationsCoherent(GameFrame &frame, const WorkloadQueue &queue,
+        const RR64GeometryMatchContext &context, const GameScene &scene)
+    {
+        RR64PipelineDiagnostics::Scope diagnosticScope(RR64PipelineDiagnostics::Stage::GeometryCoherence);
+        using namespace RR64CoordinateConsistency;
+        auto translation = [](const hlslpp::float4x4 &matrix) {
+            return std::array<float, 3>{ matrix[3][0], matrix[3][1], matrix[3][2] };
+        };
+        // A world mapping is shared across passes. Do not change it using one
+        // camera's evidence if another projection also consumes that world.
+        auto exclusiveProjection = [&](const GameIndices::Projection &indices, uint32_t world) {
+            const auto evidence = context.workloads.find(indices.workloadIndex);
+            if (evidence == context.workloads.end()) return false;
+            const auto key = rr64ProjectionKey(indices.fbPairIndex, indices.projectionIndex);
+            for (const auto &entry : evidence->second.evidence->projectionTransforms)
+                if (entry.first != key && entry.second.count(world)) return false;
+            const auto &load = queue.workloads[indices.workloadIndex];
+            for (const auto &ortho : frame.orthographicScenes) for (const auto &other : ortho.projections) {
+                if (other.workloadIndex != indices.workloadIndex) continue;
+                const auto &projection = load.fbPairs[other.fbPairIndex].projections[other.projectionIndex];
+                for (unsigned c = 0; c < projection.gameCallCount; ++c) {
+                    const auto &call = projection.gameCalls[c];
+                    const uint64_t end = uint64_t(call.meshDesc.faceIndicesStart) + uint64_t(call.callDesc.triangleCount)*3;
+                    if (end > load.drawData.faceIndices.size()) return false;
+                    for (uint64_t i = call.meshDesc.faceIndicesStart; i < end; ++i) {
+                        const auto vertex = load.drawData.faceIndices[size_t(i)];
+                        if (vertex >= load.drawData.worldIndices.size() || load.drawData.worldIndices[vertex] == world) return false;
+                    }
+                }
+            }
+            return true;
+        };
+        // Check only worlds actually used by this projection. A scene-wide
+        // union would incorrectly couple an actor to another pass's camera.
+        for (const auto &indices : scene.projections) {
