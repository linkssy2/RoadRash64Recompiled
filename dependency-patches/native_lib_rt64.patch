+    static uint32_t rr64CertifyScene(const GameFrame &frame, const WorkloadQueue &queue,
+        const RR64GeometryMatchContext &context, const GameScene &current, const GameScene &previous)
+    {
+        RR64PipelineDiagnostics::Scope diagnosticScope(RR64PipelineDiagnostics::Stage::GeometryCertify);
+        uint32_t reasons = (rr64SceneRoles(queue, current) == rr64SceneRoles(queue, previous)) ? 0u : 1u;
+        const auto currentUsed = rr64SceneTransforms(context, current);
+        const auto previousUsed = rr64SceneTransforms(context, previous);
+        const uint32_t currentW = current.projections.front().workloadIndex;
+        const uint32_t previousW = previous.projections.front().workloadIndex;
+        const auto &mapping = frame.frameMap.workloads[currentW];
+        std::set<uint32_t> matchedPrevious;
+        for (uint32_t t : currentUsed) {
+            const auto *mesh = context.get(currentW, t);
+            if ((mesh == nullptr) || !mesh->valid) { reasons |= 2u; }
+            if ((t >= mapping.transforms.size()) || !mapping.transforms[t].mapped) {
+                reasons |= 4u;
+                rr64ObserveMatch(0,frame,queue,context,current.projections.front(),t);
+                continue;
+            }
+            const uint32_t previousT = mapping.transforms[t].prevTransformIndex;
+            if ((mapping.prevWorkloadIndex != previousW) || !previousUsed.count(previousT) ||
+                !matchedPrevious.insert(previousT).second) {
+                reasons |= 4u;
+                continue;
+            }
+            const auto *previousMesh = context.get(previousW, previousT);
+            if ((previousMesh == nullptr) || !previousMesh->valid) { reasons |= 2u; continue; }
+            const auto &data = queue.workloads[currentW].drawData;
+            const bool automatic = data.transformGroups[data.worldTransformGroups[t]].matrixId == G_EX_ID_AUTO;
+            if ((mesh == nullptr) || (mesh->topologyToken == 0) ||
+                (mesh->topologyToken != previousMesh->topologyToken) ||
+                (automatic && (mesh->geometryToken != previousMesh->geometryToken))) {
+                reasons |= 16u;
+            }
+        }
+        if (matchedPrevious.size() != previousUsed.size()) { reasons |= 4u; }
+        for (uint32_t t : previousUsed) {
+            const auto *mesh = context.get(previousW, t);
+            if ((mesh == nullptr) || !mesh->valid) { reasons |= 2u; }
+        }
+        for (const auto &projection : current.projections) {
+            const uint32_t t = queue.workloads[currentW].fbPairs[projection.fbPairIndex].projections[projection.projectionIndex].transformsIndex;
+            if ((t >= mapping.viewProjections.size()) || !mapping.viewProjections[t].mapped) { reasons |= 1u; }
+        }
+        return reasons;
+    }
