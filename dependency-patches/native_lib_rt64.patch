+    static bool rr64AutomaticGeometryCompatible(const RR64GeometryMatchContext &context,
+        uint32_t currentWorkload, uint32_t currentTransform, uint32_t previousWorkload, uint32_t previousTransform)
+    {
+        const auto *current = context.get(currentWorkload, currentTransform);
+        const auto *previous = context.get(previousWorkload, previousTransform);
+        return (current != nullptr) && (previous != nullptr) && current->valid && previous->valid &&
+            (current->geometryToken != 0) && (current->geometryToken == previous->geometryToken);
