+                            if (vertices[v] >= data.worldIndices.size()) {
+                                validTriangle = false;
+                                continue;
+                            }
+                            transforms[v] = data.worldIndices[vertices[v]];
+                            if (transforms[v] >= result.transforms.size()) {
+                                validTriangle = false;
+                                continue;
+                            }
+                            if (!seen[transforms[v]]) {
+                                seen[transforms[v]] = 1;
+                                used.insert(transforms[v]);
+                            }
+                            result.transforms[transforms[v]].used = true;
+                        }
