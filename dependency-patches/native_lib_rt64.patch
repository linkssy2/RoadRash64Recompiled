+                const auto &projection = pair.projections[p];
+                if (projection.type != Projection::Type::Perspective) {
+                    continue;
+                }
+                auto &used = result.projectionTransforms[rr64ProjectionKey(f, p)];
+                // Validate every triangle as before, but insert each transform
+                // into this projection's ordered set only on its first use.
+                // Full-world meshes otherwise repeat tree lookups per vertex.
+                std::vector<uint8_t> seen(result.transforms.size(), 0);
+                for (uint32_t c = 0; c < projection.gameCallCount; c++) {
+                    const auto &call = projection.gameCalls[c];
+                    const uint64_t begin = call.meshDesc.faceIndicesStart;
+                    const uint64_t end = begin + uint64_t(call.callDesc.triangleCount) * 3;
