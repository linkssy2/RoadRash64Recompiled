+                mesh.valid = false;
+                continue;
+            }
+            const uint64_t begin = data.worldTransformVertexIndices[t];
+            const uint64_t end = (t + 1 < data.worldTransformVertexIndices.size()) ?
+                data.worldTransformVertexIndices[t + 1] : data.vertexCount();
+            if ((end < begin) || (end * 3 > data.posFloats.size())) {
+                mesh.valid = false;
+                continue;
+            }
+            mesh.positionCount = size_t((end - begin) * 3);
