+    static std::set<uint32_t> rr64SceneTransforms(const RR64GeometryMatchContext &context, const GameScene &scene) {
+        std::set<uint32_t> used;
+        for (const auto &projection : scene.projections) {
+            const auto &workload = context.workloads.at(projection.workloadIndex);
+            const auto found = workload.evidence->projectionTransforms.find(rr64ProjectionKey(projection.fbPairIndex, projection.projectionIndex));
+            if (found != workload.evidence->projectionTransforms.end()) {
+                used.insert(found->second.begin(), found->second.end());
+            }
+        }
+        return used;
+    }
