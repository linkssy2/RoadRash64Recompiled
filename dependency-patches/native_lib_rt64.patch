+    static std::shared_ptr<const RR64WorkloadGeometry> rr64SubmittedGeometry(Workload &workload, bool skipExplicitCertification) {
+        auto &cached = workload.rr64GeometryCache[skipExplicitCertification ? 1 : 0];
+        // Debugger-paused workloads may be edited without a new submission.
+        if (workload.paused) {
+            for (auto &certificate : workload.rr64GeometryCache) { certificate.reset(); }
+            auto evidence = rr64CollectGeometry(workload, skipExplicitCertification);
+            rr64HashGeometry(evidence);
+            return std::make_shared<const RR64WorkloadGeometry>(std::move(evidence));
+        }
+        if (!cached) {
+            auto evidence = rr64CollectGeometry(workload, skipExplicitCertification);
+            rr64HashGeometry(evidence);
+            cached = std::make_shared<const RR64WorkloadGeometry>(std::move(evidence));
+        }
+        return cached;
+    }
