+    for (int i = 0; i < 4; ++i) {
+        // Selecting an unrelated slot (or swapping devices) must not reset
+        // the saved/custom/empty layout chosen for an existing device.
+        profiles::set_input_profile_for_player(i, slots[i].controller ?
+            selected_profiles[i].first : -1, InputDevice::Controller);
+        profiles::set_input_profile_for_player(i, slots[i].keyboard_enabled ?
+            selected_profiles[i].second : -1, InputDevice::Keyboard);
