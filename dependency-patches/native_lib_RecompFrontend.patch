+bool players::select_player_device(int index, SDL_GameController* controller) {
+    const auto connected = recompinput::connected_controllers();
+    std::scoped_lock lock(assignment_mutex);
+    if (index < 0 || index >= 4 || PlayerState.is_assigning) return false;
