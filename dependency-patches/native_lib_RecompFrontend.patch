+namespace {
+struct ModAction {
+    std::function<std::string()> label;
+    std::function<bool()> enabled;
+    std::function<void()> invoke;
+};
+std::unordered_map<std::string, ModAction> mod_actions;
+
+struct ModActionState {
+    std::string label = "Configure";
+    bool enabled = false;
+};
+
+ModActionState mod_action_state(const std::string& id, bool has_config) {
+    const auto found = mod_actions.find(id);
+    if (found == mod_actions.end()) return {"Configure", has_config};
+    const auto action = found->second;
+    std::string label = action.label ? action.label() : "Configure";
+    if (label.empty()) label = "Configure";
+    return {std::move(label), !action.enabled || action.enabled()};
+}
+
+bool invoke_mod_action(const std::string& id) {
+    const auto found = mod_actions.find(id);
+    if (found == mod_actions.end()) return false;
+    // A callback may unregister itself or change its enabled state. Keep its
+    // lifetime independent of the registry and recheck stale button presses.
+    const auto action = found->second;
+    if (!action.enabled || action.enabled()) action.invoke();
+    return true;
+}
+} // namespace
+
+void register_mod_action(const std::string& mod_id,
+                         std::function<std::string()> label,
