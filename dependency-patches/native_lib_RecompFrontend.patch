+bool players::select_player_device(int index, SDL_Gamepad* controller) {
+    const auto connected = recompinput::connected_controllers();
+    std::scoped_lock lock(assignment_mutex);
+    if (index < 0 || index >= 4 || PlayerState.is_assigning) return false;
+    if (controller && std::find(connected.begin(), connected.end(), controller) == connected.end()) return false;
+    auto& slots = PlayerState.players;
+    std::array<std::pair<int, int>, 4> selected_profiles;
+    for (int i = 0; i < 4; ++i) {
+        selected_profiles[i] = {
+            profiles::get_input_profile_for_player(i, InputDevice::Controller),
+            profiles::get_input_profile_for_player(i, InputDevice::Keyboard)};
+    }
+    // Swap occupied devices rather than allowing two players to share a pad.
+    if (controller) for (int i = 0; i < 4; ++i) {
+        if (i != index && slots[i].controller == controller) {
+            std::swap(slots[i], slots[index]);
+            std::swap(explicit_keyboard[i], explicit_keyboard[index]);
+            std::swap(selected_profiles[i], selected_profiles[index]);
+            break;
+        }
+    }
+    const bool changed_device = slots[index].controller != controller ||
+        slots[index].keyboard_enabled != !controller;
+    slots[index].controller = controller;
+    slots[index].keyboard_enabled = !controller;
+    explicit_keyboard[index] = !controller;
+    if (changed_device) {
+        selected_profiles[index] = {
+            controller ? profiles::get_controller_profile_index_from_sdl_controller(controller) : -1,
+            controller ? -1 : profiles::get_default_keyboard_profile_for_player(index)};
+    }
+    slots.recount();
+    for (int i = 0; i < 4; ++i) {
+        // Selecting an unrelated slot (or swapping devices) must not reset
+        // the saved/custom/empty layout chosen for an existing device.
+        profiles::set_input_profile_for_player(i, slots[i].controller ?
+            selected_profiles[i].first : -1, InputDevice::Controller);
+        profiles::set_input_profile_for_player(i, slots[i].keyboard_enabled ?
+            selected_profiles[i].second : -1, InputDevice::Keyboard);
+    }
+    if (recompui::controls_page) recompui::controls_page->force_update();
+    return true;
+}
