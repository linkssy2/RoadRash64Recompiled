+    auto next = PlayerState.players;
+    reconcile_local_players(next, connected, include_keyboard);
+    bool changed = false;
+    for (unsigned i = 0; i < next.size(); ++i) {
+        const auto& before = PlayerState.players[i];
+        const auto& after = next[i];
+        if (before.controller == after.controller && before.keyboard_enabled == after.keyboard_enabled) continue;
+        changed = true;
+        // Never let a leftover keyboard binding drive a controller-only slot.
+        profiles::set_input_profile_for_player(i, after.controller ?
+            profiles::get_controller_profile_index_from_sdl_controller(after.controller) : -1, InputDevice::Controller);
+        profiles::set_input_profile_for_player(i, after.keyboard_enabled ?
+            profiles::get_default_keyboard_profile_for_player(i) : -1, InputDevice::Keyboard);
+    }
+    if (changed) {
+        next.recount();
+        PlayerState.players = next;
