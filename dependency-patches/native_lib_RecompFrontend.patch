+void players::refresh_connected_players(bool include_keyboard) {
+    // Poll on the UI thread; preserve surviving slots and explicit reassignments.
+    const auto connected = recompinput::connected_controllers();
+    std::scoped_lock lock(assignment_mutex);
+    if (PlayerState.is_assigning) return;
+    include_keyboard = include_keyboard || std::any_of(explicit_keyboard.begin(), explicit_keyboard.end(), [](bool selected) { return selected; });
+    static std::vector<SDL_GameController*> previous;
+    static bool previous_keyboard = false;
+    static bool initialized = false;
+    if (initialized && previous == connected && previous_keyboard == include_keyboard) return;
+    previous = connected;
+    previous_keyboard = include_keyboard;
