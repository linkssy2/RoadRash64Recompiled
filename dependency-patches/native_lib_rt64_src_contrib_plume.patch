@@ -15,10 +15,85 @@
 #include <CoreFoundation/CoreFoundation.h>
 
 #include <algorithm>
+#include <atomic>
+#include <cstdlib>
 #include <mutex>
+#include <string>
+#include <unistd.h>
 
 #include "plume_metal.h"
 
+namespace plume {
+    // RR64-MAC: pipeline failure diagnostics.
+    //
+    // When the GPU driver's compiler cannot build a pipeline, Metal returns no
+    // pipeline state and the renderer is left with nothing to draw: the app
+    // shows a black window and stops responding. Instead, name the shaders
+    // involved (stderr and ~/Library/Logs/<app>-gpu.log), then tell the player
+    // and quit. PLUME_METAL_CONTINUE_ON_PIPELINE_FAILURE=1 keeps running so
+    // every failing pipeline gets logged.
+
+    // Set by RT64's CREATE_SHADER_INPUTS just before a built-in Metal shader is
+    // created on the same thread; MetalShader takes it as its debug name.
+    static thread_local const char *metalShaderNameHint = nullptr;
+
+    void MetalShaderNameHint(const char *name) {
+        metalShaderNameHint = name;
+    }
+
+    static std::string metalShaderLabel(const MetalShader *shader) {
+        if (shader == nullptr) {
+            return "(none)";
+        }
+        if ((shader->debugName != nullptr) && (shader->debugName->length() > 0)) {
+            return shader->debugName->utf8String();
+        }
+        std::string label = (shader->functionName != nullptr) ? shader->functionName->utf8String() : "?";
+        return label + " (" + std::to_string(shader->blobSize) + "-byte library)";
+    }
+
+    static void reportMetalPipelineFailure(const char *kind, const std::string &shaders, NS::Error *error) {
+        const char *reason = ((error != nullptr) && (error->localizedDescription() != nullptr)) ? error->localizedDescription()->utf8String() : "unknown error";
+        const std::string line = std::string(kind) + " pipeline [" + shaders + "] failed: " + reason;
+        fprintf(stderr, "plume: %s\n", line.c_str());
+
+        static std::mutex logMutex;
+        std::string logPath;
+        if (const char *home = getenv("HOME")) {
+            logPath = std::string(home) + "/Library/Logs/" + getprogname() + "-gpu.log";
+            std::lock_guard<std::mutex> lock(logMutex);
+            if (FILE *log = fopen(logPath.c_str(), "a")) {
+                fprintf(log, "%s\n", line.c_str());
+                fclose(log);
+            }
+        }
+
+        if (getenv("PLUME_METAL_CONTINUE_ON_PIPELINE_FAILURE") != nullptr) {
+            return;
+        }
+
+        // One alert; other compile threads keep logging while it is open.
+        static std::atomic<bool> alerted{ false };
+        if (alerted.exchange(true)) {
+            return;
+        }
+
+#if !PLUME_IOS
+        const std::string message =
+            "This Mac's graphics driver could not compile the game's Metal shaders, so the game cannot draw and will quit.\n\n"
+            "First failure: " + line + "\n\n"
+            "Every failure is listed in " + (logPath.empty() ? std::string("the terminal output") : logPath) + ".";
+        CFStringRef cfMessage = CFStringCreateWithCString(kCFAllocatorDefault, message.c_str(), kCFStringEncodingUTF8);
+        CFUserNotificationDisplayAlert(0, kCFUserNotificationStopAlertLevel, nullptr, nullptr, nullptr,
+            CFSTR("Graphics driver error"), cfMessage, CFSTR("Quit"), nullptr, nullptr, nullptr);
+        if (cfMessage != nullptr) {
+            CFRelease(cfMessage);
+        }
+#endif
+        _exit(1); // other threads are mid-flight; skip static destructors
+    }
+};
+
