<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Same Vulkan gate as the AeroGauge template: the probe is meaningless
         without a Vulkan driver. Note the known 1.1-vs-1.2 tension: this
         gates on Vulkan 1.1, but plume requests a 1.2 instance (see
         docs/ANDROID_PROBE.md). The probe reports what actually happens. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="RR64 RT64 Probe" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:hasCode="true">
        <activity android:name=".ProbeActivity" android:exported="true" android:screenOrientation="sensorLandscape" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode|layoutDirection|locale|navigation|density" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
